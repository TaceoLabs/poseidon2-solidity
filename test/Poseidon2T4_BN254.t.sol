    function test_compress_reverts_when_input_not_in_field() public {
        vm.expectRevert(Poseidon2T4_BN254.NotInPrimefield.selector);
        Poseidon2T4_BN254.compress([PRIME, uint256(0), uint256(0), uint256(0)]);

        vm.expectRevert(Poseidon2T4_BN254.NotInPrimefield.selector);
        Poseidon2T4_BN254.compress([uint256(0), PRIME, uint256(0), uint256(0)]);

        vm.expectRevert(Poseidon2T4_BN254.NotInPrimefield.selector);
        Poseidon2T4_BN254.compress([uint256(0), uint256(0), PRIME, uint256(0)]);

        vm.expectRevert(Poseidon2T4_BN254.NotInPrimefield.selector);
        Poseidon2T4_BN254.compress([uint256(0), uint256(0), uint256(0), PRIME]);

        // Boundary: PRIME - 1 is in-field and must not revert.
        Poseidon2T4_BN254.compress([PRIME - 1, PRIME - 1, PRIME - 1, PRIME - 1]);
    }

    function test_permutation_reverts_when_input_not_in_field() public {
        vm.expectRevert(Poseidon2T4_BN254.NotInPrimefield.selector);
        Poseidon2T4_BN254.permutation([PRIME, uint256(0), uint256(0), uint256(0)]);

        vm.expectRevert(Poseidon2T4_BN254.NotInPrimefield.selector);
        Poseidon2T4_BN254.permutation([uint256(0), PRIME, uint256(0), uint256(0)]);

        vm.expectRevert(Poseidon2T4_BN254.NotInPrimefield.selector);
        Poseidon2T4_BN254.permutation([uint256(0), uint256(0), PRIME, uint256(0)]);

        vm.expectRevert(Poseidon2T4_BN254.NotInPrimefield.selector);
        Poseidon2T4_BN254.permutation([uint256(0), uint256(0), uint256(0), PRIME]);

        // Boundary: PRIME - 1 is in-field and must not revert.
        Poseidon2T4_BN254.permutation([PRIME - 1, PRIME - 1, PRIME - 1, PRIME - 1]);
    }

