    uint256 constant PRIME = 0x30644e72e131a029b85045b68181585d2833e84879b9709143e1f593f0000001;

    function _check(uint256[4] memory input, uint256[4] memory expected) internal pure {
        uint256[4] memory got = Poseidon2T4_BN254.permutation(input);
        assertEq(got[0], expected[0]);
        assertEq(got[1], expected[1]);
        assertEq(got[2], expected[2]);
        assertEq(got[3], expected[3]);
    }

    function _checkCompress(uint256[4] memory input, uint256 expected) internal pure {
        uint256 got = Poseidon2T4_BN254.compress(input);
        assertEq(got, expected);
